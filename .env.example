# ===================================
# Tiny Search Engine — Environment Variables
# ===================================
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to version control.

# ---- Frontend (Next.js) ----

# URL of the Flask backend API
# Development: http://localhost:5000
# Docker:      http://backend:5000
NEXT_PUBLIC_API_URL=http://localhost:5000

# ---- Backend (Flask) ----
# Set these in your shell or a separate backend .env file

# Flask environment: development | production | testing
FLASK_ENV=development

# Port the Flask server listens on
PORT=5000

# Max upload file size in bytes (default: 10 MB)
MAX_CONTENT_LENGTH=10485760

# CORS allowed origins (comma-separated)
# Example: http://localhost:3000,https://yourdomain.com
CORS_ORIGINS=http://localhost:3000

# ---- Optional / Future ----

# OpenAI key (for semantic search / AI summaries — Phase 5)
# OPENAI_API_KEY=sk-...

# Rate limiting (requests per minute per IP)
# RATE_LIMIT_RPM=60
